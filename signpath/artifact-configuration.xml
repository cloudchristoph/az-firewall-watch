<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference copy of the SignPath artifact configuration. SignPath keeps its own
  copy (Project > Artifact configurations); keep the two in sync.
  The Windows job uploads dist/az-firewall-watch.exe with actions/upload-artifact,
  which wraps it in a zip. ProductVersion is a wildcard so a release needs no edit here; ProductName stays pinned.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="az-firewall-watch.exe" product-name="Azure Firewall Watch" product-version="*">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
